// Prisma schema for apps/api. ADR-0002: Prisma is the query layer for Postgres.
// Phase 0 scope only: user accounts, refresh-token rotation, and the
// capability permission model (currently exercising only `microphone`,
// see packages/core/src/permissions.ts).

// Generated into src/ (not the default node_modules/@prisma/client location)
// specifically so it's a plain set of files esbuild can bundle like any
// other source file, instead of navigating pnpm's node_modules/.prisma
// symlink structure -- that indirection is what broke Netlify Functions'
// bundler ("Cannot find module '.prisma/client/default'"), independent of
// whether the client is used with a driver adapter or not.
generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  // "client" is Prisma's adapter-only engine mode: no native query-engine
  // binary at all (WASM query compiler instead), which is what
  // PrismaNeonHTTP (apps/api/src/db.ts) actually needs -- the default
  // "library" engine type still validates for a native binary at runtime
  // even when an adapter is supplied ("Prisma Client could not locate the
  // Query Engine for runtime..."), which is what broke this on Netlify
  // Functions despite the adapter already being wired up correctly.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  refreshTokens          RefreshToken[]
  permissionGrants       PermissionGrant[]
  conversations          Conversation[]
  integrationConnections IntegrationConnection[]

  @@map("users")
}

/// One row per issued refresh token. Rotation: redeeming a token creates a
/// new one and sets `replacedByTokenId`, satisfying the "refresh rotation"
/// requirement in master prompt §13. A token is valid only if `revokedAt`
/// is null and `expiresAt` is in the future.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the token — the raw token is never stored.
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  @@index([userId])
  @@map("refresh_tokens")
}

/// A capability grant is a fact recorded, never deleted (master prompt §13 —
/// immutable, exportable audit trail). Revocation sets `revokedAt`; it does
/// not remove the row.
model PermissionGrant {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, capability])
  @@map("permission_grants")
}

/// Persisted chat history (replaces Phase 0's original in-memory Map — see
/// PROJECT_INDEX.md's known-issues history). Not the semantic long-term
/// memory system described in master prompt §5.3 — that's real Phase 2+
/// work (embeddings, provenance, a user-editable view). This is just
/// "don't lose your conversations on restart," scoped honestly.
model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// First ~60 chars of the first user message, set once and never changed.
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// A live OAuth connection to an external provider (Google Calendar, Spotify).
/// `accessToken`/`refreshToken` are AES-256-GCM ciphertext, never plaintext
/// — see apps/api/src/integrations/crypto.ts. One row per (user, provider);
/// reconnecting overwrites it rather than accumulating history.
model IntegrationConnection {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google_calendar" | "spotify" — see apps/api/src/integrations/providers.ts
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@map("integration_connections")
}

/// Bridges the OAuth `/connect` redirect to its `/callback` — can't hold this
/// in memory because apps/api runs as Netlify Functions in production (see
/// db.ts), where the two requests can land on unrelated Lambda instances.
/// Consumed (deleted) by the callback, or by anything hitting an expired row.
model OAuthState {
  state        String   @id
  userId       String
  provider     String
  /// PKCE code_verifier (S256) — the callback exchanges it for the token, so a
  /// stolen `code` alone (e.g. via a leaky redirect) can't be redeemed by anyone else.
  codeVerifier String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@map("oauth_states")
}
