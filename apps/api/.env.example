NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000

# Local dev: matches docker-compose.yml at the repo root (needs Docker with
# virtualization enabled). If Docker Desktop won't start ("Virtualization
# support not detected"), use a free hosted Postgres instead — no card
# required — and paste its connection string here: console.neon.tech or
# supabase.com both work.
DATABASE_URL=postgresql://omnira:omnira@localhost:5432/omnira

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string

# Free tier, no card required: console.groq.com. Covers both /v1/chat and
# /v1/voice/transcribe (ADR-0005). Leave unset to run everything else.
GROQ_API_KEY=

# Only needed once apps/api is deployed publicly (see README's "Public
# deployment" section). Leave both unset for local/desktop-only use.
#
# The exact URL of the deployed web build, so its browser origin passes CORS.
PUBLIC_WEB_ORIGIN=
# Kill-switch for open_app/open_url/create_file/create_folder (ADR-0006/0007)
# — those tools act on whatever machine this process runs on, which is only
# ever meaningful for the local desktop deployment. Set to false on any
# hosted deployment (Render, Railway, Fly, etc.).
SYSTEM_CONTROL_AVAILABLE=true
