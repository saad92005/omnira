NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000

# Local dev: matches docker-compose.yml at the repo root.
DATABASE_URL=postgresql://omnira:omnira@localhost:5432/omnira

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string

# Required to exercise the chat agent (ADR-0003). Leave unset to run
# everything except /v1/chat.
ANTHROPIC_API_KEY=
